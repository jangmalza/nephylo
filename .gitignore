# Keep the current source; local releases, previews and backups are generated.
/outputs/
/work/*
!/work/src/
!/work/assets/
!/work/tests/
!/work/build.ps1
!/work/run-ade-dev.ps1
!/work/build-setup.ps1
!/work/compose-notices.ps1
!/work/installer/
!/work/package-release.ps1
!/work/sign-release.ps1
!/work/UPDATE-RELEASES.md
!/work/Install.cmd
!/work/generate-service-icons.ps1
!/work/generate-app-icon.ps1
!/work/README.txt
!/work/membership/
!/work/website/
!/work/configure-membership.ps1
/work/membership/node_modules/
/work/membership/client-config.json
/work/website/account-config.local.json
/work/membership/.test-data/
/work/membership/supabase/.temp/
/work/membership/supabase/.branches/

# Track test source and runners, not local diagnostics or test output.
/work/tests/*
!/work/tests/*.cs
!/work/tests/*.ps1
!/work/tests/wsl-shell-tests.py
/work/tests/ElevenPermissionProbe.cs

