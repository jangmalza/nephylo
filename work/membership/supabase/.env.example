# Copy into server secrets only. Never package these values in the app or website.
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
BILLING_ENABLED=false
SITE_URL=https://your-site.example
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MID=
# Exactly 32 random bytes encoded as standard Base64. Keep stable; rotation
# requires re-encrypting existing billing keys before replacing this secret.
BILLING_ENCRYPTION_KEY=
# At least 32 random characters, used only by the external renewal scheduler.
BILLING_CRON_SECRET=
# Published policies must exist before enabling checkout. Do not use placeholders.
BILLING_TERMS_URL=
BILLING_PRIVACY_URL=
BILLING_REFUND_URL=
BILLING_TERMS_VERSION=

# International checkout is independently disabled until merchant approval,
# published policies, the monthly KRW 3,000 product and test verification exist.
INTERNATIONAL_BILLING_ENABLED=false
LEMON_MODE=test
LEMON_API_KEY=
LEMON_WEBHOOK_SECRET=
LEMON_STORE_ID=
LEMON_PRODUCT_ID=
LEMON_VARIANT_ID=
LEMON_PRICE_ID=
# Exact HTTPS store origin, for example https://your-store.lemonsqueezy.com
LEMON_STORE_URL=
# A separate random secret of at least 32 characters. Schedule the international
# reconciliation function every five minutes. No card data enters this server.
INTERNATIONAL_BILLING_CRON_SECRET=
